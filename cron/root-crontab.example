# Root crontab for backups-trinity.
# Install: run "sudo crontab -e" and paste the lines below.
# Replace "ttpl" with the user on this server. Times are server local time.
# The script writes its own log (backup.log next to the config), so no ">>" is needed.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Every day at 01:40: DAILY_PATHS (critical services, e.g. Supabase)
40 1 * * * /opt/backups-trinity/backup.sh daily /home/ttpl/backups-trinity/backup.conf

# Every Sunday at 03:40: WEEKLY_PATHS (the whole docker folder)
# Two hours after the daily run so the two never overlap. If they do, the
# second run stops with a lock error.
40 3 * * 0 /opt/backups-trinity/backup.sh weekly /home/ttpl/backups-trinity/backup.conf
