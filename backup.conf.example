# backups-trinity configuration
#
# Install (replace "ttpl" with the user on this server):
#   sudo mkdir -p /home/ttpl/backups-trinity
#   sudo cp backup.conf.example /home/ttpl/backups-trinity/backup.conf
#   sudo chown root:root /home/ttpl/backups-trinity/backup.conf
#   sudo chmod 600 /home/ttpl/backups-trinity/backup.conf
#
# Backups and backup.log are written next to this file unless you set
# BACKUP_ROOT or LOG_FILE below.
#
# This file is read by bash: no spaces around "=", quote every value,
# and always use full paths (never ~, which is root's home under sudo/cron).


# ---------------------------------------------------------------- paths

BASE_DIR="/home/ttpl"                    # the user's home folder, change per server
DOCKER_DIR="$BASE_DIR/docker"
# BACKUP_ROOT="/mnt/backup-disk"         # optional. Default: the folder holding this file
# LOG_FILE="/var/log/backups-trinity.log" # optional. Default: <BACKUP_ROOT>/backup.log


# ---------------------------------------------------------------- what to archive
# Each entry can be a folder or a single file.

# Archived by "backup.sh daily": critical services.
DAILY_PATHS=(
  "$DOCKER_DIR/supabase-kalas"
)

# Archived by "backup.sh weekly": everything.
WEEKLY_PATHS=(
  "$DOCKER_DIR"
)

# Folders or files to leave out (full paths).
# Running database folders are copied as they are. List them here if you
# back the database up some other way.
EXCLUDE_PATHS=(
  # "$DOCKER_DIR/frappe_docker/.git"
)

# Names to leave out wherever they appear.
EXCLUDE_PATTERNS=(
  "node_modules"
  "__pycache__"
  ".git"
)


# ---------------------------------------------------------------- retention

KEEP_DAILY_DAYS=7      # delete daily run folders older than this
KEEP_WEEKLY_DAYS=28    # delete weekly run folders older than this
