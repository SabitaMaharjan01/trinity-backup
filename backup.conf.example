# trinity-backup configuration
#
# Setup: cp backup.conf.example backup.conf, then edit backup.conf.
# backup.conf is not tracked by git, so "git pull" never touches it.
#
# This file is read by bash: no spaces around "=", and quote every value.
# $USER_HOME is the home folder of the user who owns this repo, for example
# /home/ttpl. Use it instead of ~ (under sudo or cron, ~ means /root).


# ---------------------------------------------------------------- what to archive
# Each entry can be a folder or a single file.

# Archived by "backup.sh daily": critical services.
DAILY_PATHS=(
  "$USER_HOME/docker/supabase-kalas"
)

# Archived by "backup.sh weekly": everything.
WEEKLY_PATHS=(
  "$USER_HOME/docker"
)

# Archived by "backup.sh monthly" and "backup.sh quarterly": kept longer.
MONTHLY_PATHS=(
  "$USER_HOME/docker"
)
QUARTERLY_PATHS=(
  "$USER_HOME/docker"
)


# ---------------------------------------------------------------- databases
# Dumped on every run (daily, weekly, monthly and quarterly), into the same
# folder as that run's archives. One line per database container:
#   "<engine> <container> [user]"
#   engine:    postgres, mysql, mariadb or mongo
#   container: a name from: sudo docker ps --format '{{.Names}}'
#   user:      optional. Default: $POSTGRES_USER or postgres; root for mysql.
#              Supabase needs supabase_admin.
# Passwords come from the container's own environment variables
# (POSTGRES_PASSWORD, MYSQL_ROOT_PASSWORD or MARIADB_ROOT_PASSWORD,
# MONGO_INITDB_ROOT_USERNAME and _PASSWORD), so none go in this file.
# All databases in the container are dumped.
DATABASES=(
  # "postgres supabase-db supabase_admin"
  # "mariadb  frappe_docker-db-1"
  # "mongo    my-mongo"
)


# ---------------------------------------------------------------- leave out

# Folders or files to leave out (full paths).
# A running database's data folder copies badly. Once its container is in
# DATABASES, list its data folder here to save space.
EXCLUDE_PATHS=(
  # "$USER_HOME/docker/supabase-kalas/volumes/db/data"
)

# Names to leave out wherever they appear.
EXCLUDE_PATTERNS=(
  "node_modules"
  "__pycache__"
  ".git"
)


# ---------------------------------------------------------------- where and how long

# BACKUP_DIR="/mnt/backup-disk"   # optional. Default: $USER_HOME/backups

# Run folders older than this many days are deleted.
KEEP_DAILY_DAYS=7        # about 7 daily backups
KEEP_WEEKLY_DAYS=28      # about 4 weekly backups
KEEP_MONTHLY_DAYS=365    # about 12 monthly backups
KEEP_QUARTERLY_DAYS=730  # about 8 quarterly backups
